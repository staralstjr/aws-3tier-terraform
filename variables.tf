# ═══════════════════════════════════════════════════════════════════
#  변수(variable): 프로젝트 전반에서 재사용하는 값을 한 곳에서 관리
# ═══════════════════════════════════════════════════════════════════

variable "project_name" {
  description = "프로젝트 이름 — 모든 리소스 이름표(Name 태그)의 접두사로 쓰인다"
  type        = string
  default     = "3tier" # ← 원하는 이름으로 바꾸세요 (예: "myapp", "hando" 등)
}

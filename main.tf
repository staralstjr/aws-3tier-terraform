# ┌─────────────────────────────────────────────────────────────┐
# │ 1) Terraform 자체 설정 + 어떤 provider(공급자)를 쓸지 선언       │
# └─────────────────────────────────────────────────────────────┘
terraform {
  required_providers {
    aws = {
      source  = "hashicorp/aws" # AWS용 공식 플러그인
      version = "~> 5.0"        # 5.x 버전대를 사용
    }
  }
}

# ┌─────────────────────────────────────────────────────────────┐
# │ 2) provider 설정: "AWS를, 서울 리전에서 쓴다"                    │
# │    자격증명(Access Key)은 아까 aws configure 한 걸 자동으로 씀   │
# └─────────────────────────────────────────────────────────────┘
provider "aws" {
  region = "ap-northeast-2" # 서울
}

# ┌─────────────────────────────────────────────────────────────┐
# │ 3) 우리의 첫 리소스: VPC 하나                                    │
# │    "10.0.0.0/16 이라는 큰 사설 네트워크 동네를 하나 만들어줘"     │
# └─────────────────────────────────────────────────────────────┘
resource "aws_vpc" "main" {
  cidr_block = "10.0.0.0/16" # 1교시에서 배운 그 CIDR! 약 6.5만개 주소

  enable_dns_support   = true # VPC 안에서 도메인 이름 해석 켜기
  enable_dns_hostnames = true # 인스턴스에 DNS 이름 붙이기 (나중에 필요)

  tags = {
    Name = "${var.project_name}-vpc" # 콘솔에서 알아보기 쉽게 붙이는 이름표
  }
}
